{
  "name": "term-manager",
  "version": "0.3.1",
  "description": "Linux 终端管理器：标签页重命名/分组/排序 + 多 profile，类似 Windows Terminal",
  "main": "./out/main/index.js",
  "author": "wskgithub <wskgithub@users.noreply.github.com>",
  "homepage": "https://github.com/wskgithub/term-manager",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wskgithub/term-manager.git"
  },
  "bugs": {
    "url": "https://github.com/wskgithub/term-manager/issues"
  },
  "desktopName": "term-manager.desktop",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -b",
    "rebuild": "electron-rebuild",
    "postinstall": "electron-rebuild",
    "smoke": "electron-vite build && electron out/main/index.js --smoke --no-sandbox",
    "dist": "TERM_MGR_E2E=0 electron-vite build && ELECTRON_BUILDER_CACHE=\"$PWD/.cache/electron-builder\" ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/ electron-builder --linux",
    "dist:dir": "TERM_MGR_E2E=0 electron-vite build && ELECTRON_BUILDER_CACHE=\"$PWD/.cache/electron-builder\" ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/ electron-builder --linux deb --dir"
  },
  "build": {
    "appId": "io.github.wskgithub.term-manager",
    "productName": "term-manager",
    "directories": {
      "output": "dist"
    },
    "electronDist": "node_modules/electron/dist",
    "files": [
      "out/**"
    ],
    "linux": {
      "target": [
        "deb",
        "AppImage",
        "rpm"
      ],
      "category": "Utility;TerminalEmulator;",
      "syncDesktopName": true,
      "desktop": {
        "entry": {
          "Name": "Term Manager",
          "GenericName": "终端管理器",
          "Keywords": "terminal;tmux;shell;console;"
        }
      }
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "x11-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "tmux"
      ],
      "recommends": [
        "libappindicator3-1",
        "python3-nautilus"
      ],
    "fpm": [
      "build/nautilus-python/term_manager_nautilus.py=/usr/share/nautilus-python/extensions/term_manager_nautilus.py",
      "src/shared/agents.json=/usr/share/nautilus-python/extensions/term-manager-agents.json"
    ]
  },
  "rpm": {
      "depends": [
        "gtk3",
        "libnotify",
        "nss",
        "libXScrnSaver",
        "libXtst",
        "xdg-utils",
        "xorg-x11-utils",
        "at-spi2-core",
        "libuuid",
        "libsecret",
        "tmux"
      ],
    "fpm": [
      "build/nautilus-python/term_manager_nautilus.py=/usr/share/nautilus-python/extensions/term_manager_nautilus.py",
      "src/shared/agents.json=/usr/share/nautilus-python/extensions/term-manager-agents.json"
    ]
  }
},
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.15.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.4.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^5.6.3",
    "vite": "^7.3.6"
  }
}
